# 데이터베이스 설정
DATABASE_URL=postgresql+asyncpg://uai:uai_password@localhost:5432/uai_compass
PII_DATABASE_SCHEMA=pii

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT 설정
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC 설정 (SSO)
OIDC_PROVIDER_URL=https://sso.university.ac.kr
OIDC_CLIENT_ID=uai-compass-client
OIDC_CLIENT_SECRET=change-this-secret

# 앱 설정
APP_NAME=U-AI Compass
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# 가명화 설정
PSEUDONYM_SALT=change-this-salt-in-production

# MinIO (객체 스토리지)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=uai-compass-backend
